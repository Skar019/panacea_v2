# Copy this file to .env and fill in your own values. Never commit .env.

# Any OpenAI-compatible model service. Examples: Nebius Token Factory, Gemini.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# One or more model ids, comma separated. If one hits its limit, the next is tried.
NEBIUS_MODELS=

# Web, CAD and tutorial search (free tier at tavily.com)
TAVILY_API_KEY=

# Optional: raise rate limits
GITHUB_TOKEN=
S2_API_KEY=
OPENALEX_EMAIL=
